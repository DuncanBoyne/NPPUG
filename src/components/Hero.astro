---
// Page hero for every inner page. Cream ground, kicker, display headline, lede.
interface Props {
  title: string;
  subtitle?: string;
  kicker?: string;
  showCta?: boolean;
  ctaText?: string;
  ctaLink?: string;
  secondaryCta?: string;
  secondaryCtaLink?: string;
}

const {
  title,
  subtitle,
  kicker,
  showCta = false,
  ctaText = 'Join us',
  ctaLink = '/contact',
  secondaryCta,
  secondaryCtaLink,
} = Astro.props;
---

<section class="page-hero">
  <div class="wrap">
    <div class="max-w-3xl flex flex-col gap-5">
      {kicker && <span class="kicker">{kicker}</span>}
      <h1 class="h-display text-text">{title}</h1>
      {subtitle && <p class="lede">{subtitle}</p>}
      {showCta && (
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a href={ctaLink} class="btn btn-primary btn-lg">
            {ctaText}
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          {secondaryCta && secondaryCtaLink && (
            <a href={secondaryCtaLink} class="btn btn-ghost btn-lg">{secondaryCta}</a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
