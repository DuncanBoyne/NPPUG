---
// "Your first meetup" promise block. Used on the homepage and on upcoming
// event pages so newcomers always know exactly what they are walking into.
const steps = [
  { time: '18:15', title: 'Doors open, pizza arrives', text: 'Grab a slice, find a seat, say hello to whoever is nearest. Or don’t, that is fine too.' },
  { time: '18:30', title: 'Welcome and quick intros', text: 'Who we are, what is coming up, and a thank-you to the sponsor paying for the room.' },
  { time: '18:40', title: 'Two talks with a break between', text: 'Real demos from people who built the thing. Questions welcome throughout.' },
  { time: '20:30', title: 'Networking, then home by 20:45', text: 'Stay for a chat or slip out. Both are fine.' },
];
---

<section class="section" aria-labelledby="first-meetup-heading">
  <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-5 flex flex-col gap-5">
      <span class="kicker">Your first meetup</span>
      <h2 id="first-meetup-heading" class="h-section text-text">Never been? Here is exactly how the evening goes.</h2>
      <p class="lede">Turn up on your own, sit anywhere, ask anything. Nobody will try to sell you something and nobody minds if you have never opened Power Apps.</p>
      <p class="text-[15px] text-text-light">It is completely free, the pizza too, thanks to our sponsors. Everything runs under our
        <a href="/code-of-conduct" class="text-primary font-semibold hover:text-primary-dark">code of conduct</a>.</p>
    </div>

    <ol class="lg:col-span-7 card px-6 md:px-10 py-3 md:py-5 flex flex-col">
      {steps.map((step, i) => (
        <li class:list={['grid grid-cols-[72px_1fr] md:grid-cols-[96px_1fr] gap-4 md:gap-6 py-4 md:py-5', i < steps.length - 1 && 'border-b border-border']}>
          <span class="font-display font-bold text-xl md:text-[22px] text-primary">{step.time}</span>
          <div class="flex flex-col gap-1">
            <span class="font-bold text-[17px] text-text">{step.title}</span>
            <span class="text-[15px] text-text-light">{step.text}</span>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
