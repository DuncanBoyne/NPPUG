---
interface Props {
  name: string;
  title: string;
  company?: string;
  bio: string;
  slug: string;
  image?: string;
  linkedin?: string;
  twitter?: string;
}

const { name, title, company, bio, slug, image, linkedin, twitter } = Astro.props;

const initials = name.split(' ').map(n => n[0]).join('').toUpperCase();
---

<article class="card p-6 md:p-7 flex flex-col gap-4 transition-shadow hover:shadow-[0_24px_48px_-28px_rgba(30,27,46,0.35)]">
  <div class="flex items-start gap-4">
    {image ? (
      <img src={image} alt={name} class="w-16 h-16 rounded-full object-cover shrink-0" />
    ) : (
      <div class="w-16 h-16 rounded-full bg-primary-tint text-primary-deep flex items-center justify-center font-display font-bold text-xl shrink-0" aria-hidden="true">
        {initials}
      </div>
    )}
    <div class="flex flex-col gap-0.5 min-w-0">
      <h3 class="font-display font-bold text-xl tracking-tight text-text">
        <a href={`/speakers/${slug}`} class="hover:text-primary transition-colors">{name}</a>
      </h3>
      <p class="text-sm font-semibold text-primary">{title}</p>
      {company && <p class="text-sm text-text-light">{company}</p>}
    </div>
  </div>

  <p class="text-[15px] leading-relaxed text-text-light line-clamp-3">{bio}</p>

  <div class="mt-auto pt-1 flex items-center justify-between">
    <a href={`/speakers/${slug}`} class="link-arrow">
      View profile<span class="sr-only">: {name}</span>
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>

    <div class="flex gap-3">
      {linkedin && (
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="text-text-faint hover:text-primary transition-colors" aria-label={`${name}'s LinkedIn (opens in new tab)`}>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9.5h4V21H3zM9.5 9.5H13.3v1.6h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.2c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4z" />
          </svg>
        </a>
      )}
      {twitter && (
        <a href={twitter} target="_blank" rel="noopener noreferrer" class="text-text-faint hover:text-primary transition-colors" aria-label={`${name}'s X profile (opens in new tab)`}>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
