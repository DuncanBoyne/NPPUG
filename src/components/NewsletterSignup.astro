---
// Email capture. Renders a real signup form once NEWSLETTER_FORM_ACTION is
// configured in src/config.ts; until then it falls back to LinkedIn + contact
// so the section is never a dead end.
import { SITE, NEWSLETTER_FORM_ACTION } from '../config';
---

<section class="wrap pb-16 md:pb-24" aria-labelledby="newsletter-heading">
  <div class="card px-6 py-8 md:px-12 md:py-11 grid gap-6 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-6 flex flex-col gap-2">
      <h2 id="newsletter-heading" class="font-display font-extrabold tracking-tight text-2xl md:text-[28px] leading-tight text-text">One email a month. The next date, the speakers, nothing else.</h2>
      <p class="text-[15px] text-text-light">Unsubscribe any time. We never share your address.</p>
    </div>

    <div class="lg:col-span-6">
      {NEWSLETTER_FORM_ACTION ? (
        <form action={NEWSLETTER_FORM_ACTION} method="post" class="flex flex-col sm:flex-row gap-3">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input id="newsletter-email" type="email" name="email" required placeholder="you@company.co.uk" class="input flex-grow" />
          <button type="submit" class="btn btn-primary shrink-0">Keep me posted</button>
        </form>
      ) : (
        <div class="flex flex-col sm:flex-row gap-3 lg:justify-end">
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Follow on LinkedIn<span class="sr-only"> (opens in new tab)</span>
          </a>
          <a href="/contact" class="btn btn-ghost">Ask to join the mailing list</a>
        </div>
      )}
    </div>
  </div>
</section>
