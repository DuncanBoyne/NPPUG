---
// Upcoming dates from the events collection. This used to be a hard-coded 2026 list,
// which went empty once every 2026 date had passed.
import { getCollection } from 'astro:content';
import { isOnlineEvent } from '../lib/events';

interface ScheduledEvent {
  date: Date;
  endDate?: Date;
  title: string;
  type: 'in-person' | 'virtual' | 'conference';
  venue?: string;
  url?: string;
}

const now = new Date();
const upcomingEvents: ScheduledEvent[] = (await getCollection('events'))
  .filter((e) => (e.data.endDate ?? e.data.date) >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 6)
  .map((e) => ({
    date: e.data.date,
    endDate: e.data.endDate,
    title: e.slug.includes('eoepps') ? 'EoES' : 'NPPUG Meetup',
    type: e.slug.includes('eoepps') ? 'conference' : isOnlineEvent(e) ? 'virtual' : 'in-person',
    venue: e.data.location.split(',')[0],
    url: e.data.registrationUrl,
  }));

// Dates are naive wall-clock times parsed as UTC, so format in UTC.
const fmt = (d: Date, o: Intl.DateTimeFormatOptions) => d.toLocaleDateString('en-GB', { ...o, timeZone: 'UTC' });
function formatTime(date: Date): string {
  const h = date.getUTCHours();
  const m = date.getUTCMinutes();
  const ampm = h >= 12 ? 'PM' : 'AM';
  const h12 = h % 12 || 12;
  return `${h12}:${String(m).padStart(2, '0')} ${ampm}`;
}
---

<div class="card overflow-hidden">
  <div class="px-6 pt-6 pb-5 border-b border-border flex flex-col gap-1.5">
    <span class="kicker">Diary</span>
    <h3 class="font-display font-bold text-xl tracking-tight text-text">Event Schedule</h3>
    <p class="text-sm text-text-light">Upcoming meetups and events</p>
  </div>

  <div class="divide-y divide-border">
    {upcomingEvents.map((event) => {
      const monthName = fmt(event.date, { month: 'long' });
      const dayNum = event.date.getUTCDate();
      const year = event.date.getUTCFullYear();
      const isConference = event.type === 'conference';
      const isVirtual = event.type === 'virtual';

      return (
        <div class="flex items-center gap-4 px-6 py-4 hover:bg-background transition-colors">
          <div class="w-14 h-14 rounded-2xl bg-primary-tint flex flex-col items-center justify-center shrink-0" aria-hidden="true">
            <span class="text-[11px] font-bold tracking-[0.1em] uppercase text-primary">
              {fmt(event.date, { month: 'short' }).slice(0, 3)}
            </span>
            <span class="font-display font-bold text-xl leading-none text-primary-deep">
              {isConference && event.endDate ? `${dayNum}-${event.endDate.getUTCDate()}` : dayNum}
            </span>
          </div>
          <div class="flex-1 min-w-0 flex flex-col gap-1">
            <div class="font-bold text-text">
              {event.title}
            </div>
            <div class="text-sm text-text-light">
              {isConference ? (
                <span>{monthName} {year} • {event.venue}</span>
              ) : (
                <span>
                  {fmt(event.date, { weekday: 'long' })}, {dayNum} {monthName}
                  {' • '}
                  {formatTime(event.date)}{event.endDate && ` - ${formatTime(event.endDate)}`}
                </span>
              )}
            </div>
            <div class="pt-0.5">
              {isConference ? (
                <a href={event.url} target="_blank" rel="noopener noreferrer" class="pill pill-primary hover:bg-primary hover:text-white transition-colors">
                  Conference
                </a>
              ) : isVirtual ? (
                <span class="pill">Virtual</span>
              ) : (
                <span class="pill">In Person</span>
              )}
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <div class="px-6 py-4 bg-background border-t border-border text-center">
    <p class="text-sm text-text-light">
      In-person events held at Spaces Digital Hub, Townshend House, Norwich
    </p>
  </div>
</div>
