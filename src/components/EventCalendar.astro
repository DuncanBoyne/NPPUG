---
// 2026 NPPUG Event Schedule
interface ScheduledEvent {
  date: Date;
  endDate?: Date;
  title: string;
  type: 'in-person' | 'virtual' | 'conference';
  venue?: string;
  url?: string;
}

const schedule2026: ScheduledEvent[] = [
  { date: new Date(2026, 1, 5, 18, 15), title: 'NPPUG Meetup', type: 'in-person', venue: 'Townshend House' },
  { date: new Date(2026, 2, 16, 18, 0), title: 'NPPUG Meetup', type: 'virtual' },
  // April - No event
  { date: new Date(2026, 4, 1), endDate: new Date(2026, 4, 2), title: 'EoEPPS', type: 'conference', venue: 'Norwich', url: 'https://eoepps.co.uk' },
  { date: new Date(2026, 5, 4, 18, 15), title: 'NPPUG Meetup', type: 'in-person', venue: 'Townshend House' },
  { date: new Date(2026, 6, 2, 18, 15), title: 'NPPUG Meetup', type: 'in-person', venue: 'Townshend House' },
  // August - No event
  { date: new Date(2026, 8, 15, 18, 0), title: 'NPPUG Meetup', type: 'virtual' },
  { date: new Date(2026, 9, 15, 18, 0), title: 'NPPUG Meetup', type: 'in-person', venue: 'Townshend House' },
  { date: new Date(2026, 10, 3, 18, 0), title: 'NPPUG Meetup', type: 'virtual' },
  { date: new Date(2026, 11, 3, 18, 0), title: 'NPPUG Meetup', type: 'in-person', venue: 'Townshend House' },
];

const now = new Date();
const upcomingEvents = schedule2026.filter(event => event.date > now).slice(0, 6);

function formatTime(date: Date): string {
  const h = date.getHours();
  const m = date.getMinutes();
  const ampm = h >= 12 ? 'PM' : 'AM';
  const h12 = h % 12 || 12;
  return m === 0 ? `${h12}:00 ${ampm}` : `${h12}:${String(m).padStart(2, '0')} ${ampm}`;
}
---

<div class="card overflow-hidden">
  <div class="px-6 pt-6 pb-5 border-b border-border flex flex-col gap-1.5">
    <span class="kicker">Diary</span>
    <h3 class="font-display font-bold text-xl tracking-tight text-text">2026 Event Schedule</h3>
    <p class="text-sm text-text-light">Upcoming meetups and events</p>
  </div>

  <div class="divide-y divide-border">
    {upcomingEvents.map((event) => {
      const monthName = event.date.toLocaleDateString('en-GB', { month: 'long' });
      const dayNum = event.date.getDate();
      const year = event.date.getFullYear();
      const isConference = event.type === 'conference';
      const isVirtual = event.type === 'virtual';

      return (
        <div class="flex items-center gap-4 px-6 py-4 hover:bg-background transition-colors">
          <div class="w-14 h-14 rounded-2xl bg-primary-tint flex flex-col items-center justify-center shrink-0" aria-hidden="true">
            <span class="text-[11px] font-bold tracking-[0.1em] uppercase text-primary">
              {event.date.toLocaleDateString('en-GB', { month: 'short' }).slice(0, 3)}
            </span>
            <span class="font-display font-bold text-xl leading-none text-primary-deep">
              {isConference && event.endDate ? `${dayNum}-${event.endDate.getDate()}` : dayNum}
            </span>
          </div>
          <div class="flex-1 min-w-0 flex flex-col gap-1">
            <div class="font-bold text-text">
              {event.title}
            </div>
            <div class="text-sm text-text-light">
              {isConference ? (
                <span>{monthName} {year} • {event.venue}</span>
              ) : (
                <span>
                  {event.date.toLocaleDateString('en-GB', { weekday: 'long' })}, {dayNum} {monthName}
                  {' • '}
                  {isVirtual ? `${formatTime(event.date)} - 8:00 PM` : '6:00 - 8:30 PM'}
                </span>
              )}
            </div>
            <div class="pt-0.5">
              {isConference ? (
                <a href={event.url} target="_blank" rel="noopener noreferrer" class="pill pill-primary hover:bg-primary hover:text-white transition-colors">
                  Conference
                </a>
              ) : isVirtual ? (
                <span class="pill">Virtual</span>
              ) : (
                <span class="pill">In Person</span>
              )}
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <div class="px-6 py-4 bg-background border-t border-border text-center">
    <p class="text-sm text-text-light">
      In-person events held at Spaces Digital Hub, Townshend House, Norwich
    </p>
  </div>
</div>
