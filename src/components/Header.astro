---
// Site header. Cream ground, hairline underneath, one call to action.
const navLinks = [
  { href: '/events', label: 'Events' },
  {
    label: 'Speakers',
    href: '/speakers',
    children: [
      { href: '/speakers', label: 'Our speakers' },
      { href: '/speak', label: 'Speak at NPPUG' },
    ],
  },
  {
    label: 'Sponsors',
    href: '/sponsors',
    children: [
      { href: '/sponsors', label: 'Our sponsors' },
      { href: '/sponsorship', label: 'Become a sponsor' },
    ],
  },
  {
    label: 'Resources',
    href: '/resources',
    children: [
      { href: '/resources', label: 'All resources' },
      { href: '/blog', label: 'Blog' },
      { href: '/knowledge-base', label: 'Knowledge base' },
    ],
  },
  {
    label: 'About',
    href: '/about',
    children: [
      { href: '/about', label: 'About us' },
      { href: '/team', label: 'Our team' },
      { href: '/code-of-conduct', label: 'Code of conduct' },
    ],
  },
  { href: '/contact', label: 'Contact' },
];

const mobileLinks = [
  { href: '/', label: 'Home' },
  { href: '/events', label: 'Events' },
  { href: '/speakers', label: 'Speakers' },
  { href: '/speak', label: 'Speak at NPPUG' },
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/sponsorship', label: 'Become a sponsor' },
  { href: '/resources', label: 'Resources' },
  { href: '/blog', label: 'Blog' },
  { href: '/knowledge-base', label: 'Knowledge base' },
  { href: '/about', label: 'About us' },
  { href: '/team', label: 'Our team' },
  { href: '/code-of-conduct', label: 'Code of conduct' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

const isActive = (link: { href: string; label: string }) => {
  if (currentPath === link.href || currentPath.startsWith(link.href + '/')) return true;
  if (link.label === 'Resources' && (currentPath.startsWith('/blog') || currentPath.startsWith('/knowledge-base'))) return true;
  if (link.label === 'Speakers' && currentPath.startsWith('/speak')) return true;
  if (link.label === 'Sponsors' && currentPath.startsWith('/sponsorship')) return true;
  if (link.label === 'About' && (currentPath.startsWith('/team') || currentPath.startsWith('/code-of-conduct'))) return true;
  return false;
};
---

<header class="bg-background/95 backdrop-blur border-b border-border sticky top-0 z-50" role="banner">
  <nav class="wrap" role="navigation" aria-label="Main navigation">
    <div class="h-16 md:h-[88px] flex items-center justify-between gap-6">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        <img src="/images/Logo.png" alt="" class="h-9 md:h-11 w-auto" aria-hidden="true" />
        <span class="font-display font-extrabold text-xl md:text-[22px] tracking-tight text-text">NPPUG</span>
        <span class="sr-only">Norfolk Power Platform User Group, home</span>
      </a>

      <!-- Desktop navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          link.children ? (
            <div class="relative group">
              <a
                href={link.href}
                class:list={[
                  'flex items-center gap-1 px-3 py-2 rounded-full text-[15px] font-medium transition-colors',
                  isActive(link) ? 'text-primary' : 'text-text hover:text-primary',
                ]}
                aria-haspopup="true"
              >
                {link.label}
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
                </svg>
              </a>
              <div class="absolute left-0 top-full pt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-150 z-50">
                <div class="card p-2 shadow-[0_20px_40px_-20px_rgba(30,27,46,0.35)]">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class:list={[
                        'block px-3 py-2 rounded-xl text-[15px] transition-colors',
                        currentPath === child.href || currentPath.startsWith(child.href + '/')
                          ? 'bg-primary-tint text-primary-deep font-semibold'
                          : 'text-text hover:bg-surface-muted',
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class:list={[
                'px-3 py-2 rounded-full text-[15px] font-medium transition-colors',
                isActive(link) ? 'text-primary' : 'text-text hover:text-primary',
              ]}
            >
              {link.label}
            </a>
          )
        ))}
      </div>

      <!-- Desktop CTA -->
      <a href="/events" class="btn btn-primary btn-sm hidden lg:inline-flex">
        Next meetup
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden w-11 h-11 rounded-full border border-border-strong bg-surface flex items-center justify-center"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-5 h-5 text-text" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile navigation -->
    <div id="mobile-menu" class="hidden lg:hidden pb-5 border-t border-border pt-3">
      <div class="flex flex-col gap-0.5">
        {mobileLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'block px-3 py-3 rounded-xl text-base transition-colors',
              currentPath === link.href ? 'bg-primary-tint text-primary-deep font-semibold' : 'text-text hover:bg-surface-muted',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
      <a href="/events" class="btn btn-primary w-full mt-3">Next meetup</a>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
  });
</script>
