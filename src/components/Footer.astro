---
import { SITE } from '../config';

const currentYear = new Date().getFullYear();

const eventLinks = [
  { href: '/events', label: 'Upcoming' },
  { href: '/events#past', label: 'Past events' },
  { href: SITE.eoepps, label: 'EoEPPS summit', external: true },
];

const communityLinks = [
  { href: '/speakers', label: 'Speakers' },
  { href: '/speak', label: 'Speak at NPPUG' },
  { href: '/resources', label: 'Resources' },
  { href: '/blog', label: 'Blog' },
];

const groupLinks = [
  { href: '/about', label: 'About' },
  { href: '/team', label: 'Team' },
  { href: '/sponsorship', label: 'Sponsorship' },
  { href: '/code-of-conduct', label: 'Code of conduct' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="bg-ink text-white" role="contentinfo">
  <div class="wrap pt-14 md:pt-16 pb-8">
    <div class="grid gap-10 md:grid-cols-12 mb-10">
      <!-- Brand -->
      <div class="md:col-span-5 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <img src="/images/Logo.png" alt="" class="h-9 w-auto" aria-hidden="true" />
          <span class="font-display font-extrabold text-lg md:text-xl tracking-tight">Norfolk Power Platform User Group</span>
        </div>
        <p class="text-text-on-dark text-[15px] leading-relaxed max-w-sm">
          Free monthly meetups in Norwich for everyone working with Power Platform, Power BI, Fabric, Dynamics 365 and Copilot.
        </p>
        <a
          href={SITE.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-white text-sm font-semibold hover:text-primary-soft transition-colors w-fit"
        >
          <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9.5h4V21H3zM9.5 9.5H13.3v1.6h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.2c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4z" />
          </svg>
          Follow on LinkedIn<span class="sr-only"> (opens in new tab)</span>
        </a>
      </div>

      <nav class="md:col-span-2 flex flex-col gap-3" aria-label="Events">
        <h2 class="text-[13px] font-bold tracking-[0.1em] uppercase text-white">Events</h2>
        {eventLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="text-text-faint text-sm hover:text-white transition-colors"
          >
            {link.label}{link.external && <span class="sr-only"> (opens in new tab)</span>}
          </a>
        ))}
      </nav>

      <nav class="md:col-span-2 flex flex-col gap-3" aria-label="Community">
        <h2 class="text-[13px] font-bold tracking-[0.1em] uppercase text-white">Community</h2>
        {communityLinks.map((link) => (
          <a href={link.href} class="text-text-faint text-sm hover:text-white transition-colors">{link.label}</a>
        ))}
      </nav>

      <nav class="md:col-span-3 flex flex-col gap-3" aria-label="Group">
        <h2 class="text-[13px] font-bold tracking-[0.1em] uppercase text-white">Group</h2>
        {groupLinks.map((link) => (
          <a href={link.href} class="text-text-faint text-sm hover:text-white transition-colors">{link.label}</a>
        ))}
      </nav>
    </div>

    <div class="border-t border-ink-line pt-5 flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between">
      <p class="text-text-faint text-[13px]">&copy; {currentYear} {SITE.name}. Run by volunteers. Every event is free and runs under our <a href="/code-of-conduct" class="underline hover:text-white">code of conduct</a>.</p>
      <p class="text-text-faint text-[13px]">nppug.co.uk</p>
    </div>
  </div>
</footer>
