---
import { SITE } from '../config';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: '/events', label: 'Events' },
  { href: '/speak', label: 'Become a Speaker' },
  { href: '/sponsorship', label: 'Become a Sponsor' },
  { href: '/code-of-conduct', label: 'Code of Conduct' },
  { href: '/contact', label: 'Contact' },
];

const communityLinks = [
  { href: SITE.linkedin, label: 'LinkedIn', external: true },
  { href: SITE.sessionize, label: 'Call for Speakers (Sessionize)', external: true },
  { href: SITE.eoepps, label: 'East of England Power Platform Summit', external: true },
];
---

<footer class="bg-text text-white" role="contentinfo">
  <div class="container mx-auto px-4 py-12">
    <div class="grid md:grid-cols-3 gap-10 mb-10">
      <!-- Brand -->
      <div>
        <div class="flex items-center space-x-3 mb-3">
          <img src="/images/Logo.png" alt="" class="h-10 w-auto" aria-hidden="true" />
          <span class="font-bold text-lg text-white">{SITE.name}</span>
        </div>
        <p class="text-gray-400 mb-4">
          Norfolk's Microsoft community. Free monthly meetups in Norwich — everyone welcome,
          from first flow to enterprise architecture.
        </p>
        <a
          href={SITE.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex text-gray-400 hover:text-white transition-colors"
          aria-label="Follow us on LinkedIn (opens in new tab)"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
      </div>

      <!-- Quick links -->
      <nav aria-label="Footer">
        <h2 class="font-bold text-white mb-4">Get Involved</h2>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Community -->
      <div>
        <h2 class="font-bold text-white mb-4">Around the Community</h2>
        <ul class="space-y-2">
          {communityLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-400 hover:text-white transition-colors"
              >
                {link.label}<span class="sr-only"> (opens in new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 text-center">
      <p class="text-gray-400 text-sm mb-2">
        All our events are free and open to everyone, run under our
        <a href="/code-of-conduct" class="text-gray-300 hover:text-white underline">Code of Conduct</a>.
      </p>
      <p class="text-gray-500 text-sm">&copy; {currentYear} {SITE.name}</p>
    </div>
  </div>
</footer>
