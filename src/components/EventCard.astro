---
interface Props {
  title: string;
  date: Date;
  endDate?: Date;
  location: string;
  venue: string;
  description: string;
  slug: string;
  isPast?: boolean;
  speakers?: string[];
}

const { title, date, endDate, location, venue, description, slug, isPast = false, speakers = [] } = Astro.props;

const isMultiDay = endDate && date.toDateString() !== endDate.toDateString();

const shortDate = isMultiDay
  ? `${date.getUTCDate()}–${endDate.getUTCDate()} ${date.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' })}`
  : date.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });

const startTime = date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });
const endTime = endDate ? endDate.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' }) : null;
const timeRange = isMultiDay ? null : (endTime ? `${startTime} to ${endTime}` : startTime);

const isOnline = /online|virtual/i.test(`${venue} ${location}`);
const placeLabel = isOnline ? 'Online' : location.split(',')[0].trim();
---

<article class:list={['card p-6 md:p-7 flex flex-col gap-4 transition-shadow hover:shadow-[0_24px_48px_-28px_rgba(30,27,46,0.35)]', isPast && 'opacity-80']}>
  <div class="flex items-center justify-between gap-3">
    <span class:list={['font-display font-bold text-lg', isPast ? 'text-text-light' : 'text-primary']}>{shortDate}</span>
    <span class="pill">{isPast ? 'Past' : placeLabel}</span>
  </div>

  <h3 class="h-card text-text">
    <a href={`/events/${slug}`} class="hover:text-primary transition-colors">{title}</a>
  </h3>

  <div class="flex flex-col gap-1 text-sm text-text-light">
    {timeRange && <span>{timeRange}</span>}
    <span>{venue}{!isOnline && `, ${location}`}</span>
  </div>

  <p class="text-[15px] leading-relaxed text-text-light line-clamp-3">{description}</p>

  {speakers.length > 0 && (
    <p class="text-sm text-text-light"><span class="font-semibold text-text">Speakers:</span> {speakers.join(', ')}</p>
  )}

  <a href={`/events/${slug}`} class="link-arrow mt-auto pt-1">
    Event details<span class="sr-only">: {title}</span>
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </a>
</article>
