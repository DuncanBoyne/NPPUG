---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="Contact" description="Get in touch with the Norfolk Power Platform User Group.">
  <Hero
    kicker="Say hello"
    title="Contact Us"
    subtitle="Get in touch with the Norfolk Power Platform User Group."
  />

  <section class="section" aria-label="Contact details and ways to get involved">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-8">
      <!-- Contact Info -->
      <div class="lg:col-span-5 flex flex-col gap-8">
        <div class="flex flex-col gap-4">
          <span class="kicker">Contact</span>
          <h2 class="h-section text-text">Get in Touch</h2>
          <p class="lede">
            Whether you want to become a speaker, sponsor an event, or just say hello, we'd love to hear from you.
          </p>
        </div>

        <div class="flex flex-col gap-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-primary-tint flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </div>
            <div class="flex flex-col gap-1 min-w-0">
              <h3 class="font-bold text-[17px] text-text">Follow Us on LinkedIn</h3>
              <p class="text-[15px] text-text-light">Stay updated with our latest events and news.</p>
              <a
                href="https://www.linkedin.com/company/norfolk-power-platform-user-group/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[15px] font-semibold text-primary hover:text-primary-dark transition-colors break-words"
              >
                linkedin.com/company/norfolk-power-platform-user-group<span class="sr-only"> (opens in new tab)</span>
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-primary-tint flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 21s-6-5.5-6-10a6 6 0 0 1 12 0c0 4.5-6 10-6 10z" /><circle cx="12" cy="11" r="2.5" />
              </svg>
            </div>
            <div class="flex flex-col gap-1">
              <h3 class="font-bold text-[17px] text-text">Location</h3>
              <p class="text-[15px] text-text-light">
                Norwich, Norfolk, UK<br />
                Our events are typically held at Townshend House.
              </p>
            </div>
          </div>
        </div>

        <!-- Organizers -->
        <div class="card-muted p-6 md:p-7 flex flex-col gap-3">
          <h3 class="h-card text-text">Our Organizers</h3>
          <p class="text-[15px] leading-relaxed text-text-light">
            The Norfolk Power Platform User Group is run by volunteers who are passionate about the Power Platform community.
          </p>
          <a href="/team" class="link-arrow pt-1">
            Meet the team
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>

      <!-- Speaker Submission -->
      <div class="lg:col-span-7 flex flex-col gap-5">
        <div class="card p-7 md:p-8 flex flex-col gap-6">
          <div class="flex flex-col gap-3">
            <h2 class="h-card text-[26px] text-text">Become a Speaker</h2>
            <p class="text-[15px] leading-relaxed text-text-light">
              We're always looking for speakers to share their knowledge and experiences. First-time speakers are especially welcome!
            </p>
          </div>

          <ul class="flex flex-col gap-3.5 text-[15px] leading-relaxed text-text-light">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary mt-px shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 5-5" />
              </svg>
              <span>Share real-world use cases and experiences</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary mt-px shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 5-5" />
              </svg>
              <span>Technical deep-dives on Power Platform features</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary mt-px shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 5-5" />
              </svg>
              <span>Tips and tricks for citizen developers</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary mt-px shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 5-5" />
              </svg>
              <span>Career journeys and lessons learned</span>
            </li>
          </ul>

          <div class="card-muted p-6 flex flex-col gap-3">
            <h3 class="font-bold text-[17px] text-text">Submit Your Talk</h3>
            <p class="text-[15px] leading-relaxed text-text-light">
              Submit your talk proposal through Sessionize. We welcome speakers of all experience levels!
            </p>
            <div class="pt-1">
              <a
                href="https://sessionize.com/norfolk-power-platform-user-group-IP/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                Submit on Sessionize<span class="sr-only"> (opens in new tab)</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Sponsorship -->
        <div class="card-tint p-7 md:p-8 flex flex-col gap-3">
          <h3 class="h-card text-text">Sponsorship Opportunities</h3>
          <p class="text-[15px] leading-relaxed text-text-light">
            Interested in sponsoring our events? We offer various sponsorship packages to help promote your brand to the Power Platform community.
          </p>
          <a href="/sponsors" class="link-arrow pt-1">
            View sponsorship options
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
