---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const reasons = [
  {
    title: 'Promote Your Brand',
    text: 'Reach a targeted audience of tech professionals, decision-makers, and innovators.',
    icon: 'M11 3.055A9.001 9.001 0 1 0 20.945 13H11V3.055zM20.488 9H15V3.512A9.025 9.025 0 0 1 20.488 9z',
  },
  {
    title: 'Showcase Your Expertise',
    text: 'Position yourself in the fast-growing Microsoft Power Platform ecosystem.',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  },
  {
    title: 'Demonstrate Community Support',
    text: 'Show thought leadership and commitment to the local tech community.',
    icon: 'M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z',
  },
  {
    title: 'Network Directly',
    text: 'Connect with potential clients, partners, and future hires at our events.',
    icon: 'M9 8a3.5 3.5 0 1 0 0 .01M2.5 20a6.5 6.5 0 0 1 13 0M17 9a2.5 2.5 0 1 0 0 .01M16 20a5 5 0 0 1 5.5-5',
  },
];

const tiers = [
  {
    name: 'Bronze',
    price: '£500',
    per: '/ event',
    commitment: 'Single event',
    highlight: false,
    features: [
      '<strong>Headline sponsor</strong> for one event',
      'Logo on all event marketing for that month',
      'Promotion via LinkedIn and Eventbrite',
      '<strong>15-minute presentation slot</strong> (optional)',
      'Promotional video played at event (optional)',
    ],
  },
  {
    name: 'Silver',
    price: '£300',
    per: '/ event',
    commitment: '6 event commitment',
    highlight: false,
    features: [
      '<strong>Silver sponsor</strong> for 6 events',
      'Logo displayed prominently on all marketing',
      'Shout-outs and mentions at each event',
      'Promotion via LinkedIn and Eventbrite',
      'Promotional video played at events (optional)',
    ],
  },
  {
    name: 'Gold',
    price: '£200',
    per: '/ event',
    commitment: '12 event commitment (full year)',
    highlight: true,
    features: [
      '<strong>Gold sponsor</strong> for the full year',
      'Logo at every event and on all materials',
      'Shout-outs and mentions at events',
      'Promotion via LinkedIn and Eventbrite',
      'Promotional video played at events (optional)',
    ],
  },
];
---

<BaseLayout title="Become a Sponsor" description="Sponsor the Norfolk Power Platform User Group and reach tech professionals across the region.">
  <Hero
    kicker="Sponsorship"
    title="Become a Sponsor"
    subtitle="Partner with Norfolk's thriving Power Platform community."
    showCta={true}
    ctaText="Download the sponsorship pack"
    ctaLink="/documents/NPPUG Sponsorship pack.pdf"
    secondaryCta="Talk to the team"
    secondaryCtaLink="/contact"
  />

  <!-- Why sponsor -->
  <section class="section" aria-labelledby="why-heading">
    <div class="wrap flex flex-col gap-10">
      <div class="max-w-3xl flex flex-col gap-4">
        <span class="kicker">Why sponsor</span>
        <h2 id="why-heading" class="h-section text-text">Why Sponsor Us?</h2>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        {reasons.map((reason) => (
          <div class="card p-7 flex items-start gap-5">
            <div class="w-12 h-12 rounded-2xl bg-primary-tint flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d={reason.icon} />
              </svg>
            </div>
            <div class="flex flex-col gap-1.5">
              <h3 class="font-bold text-[17px] text-text">{reason.title}</h3>
              <p class="text-[15px] leading-relaxed text-text-light">{reason.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Community reach -->
  <section class="section section-dark" aria-labelledby="reach-heading">
    <div class="wrap flex flex-col gap-10">
      <div class="max-w-3xl flex flex-col gap-4">
        <span class="kicker kicker-on-dark">Our reach</span>
        <h2 id="reach-heading" class="h-section text-white">Who you will be in front of.</h2>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        <!-- Attendees -->
        <div class="card-dark p-7 md:p-8 flex flex-col gap-4">
          <svg class="w-7 h-7 text-primary-soft" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><circle cx="17" cy="9" r="2.5" /><path d="M16 20a5 5 0 0 1 5.5-5" />
          </svg>
          <h3 class="h-card text-white">Attendees</h3>
          <ul class="flex flex-col gap-2 text-[15px] text-text-on-dark">
            <li><strong class="text-white">20+</strong> average attendees at in-person events</li>
            <li><strong class="text-white">40+</strong> average attendees at virtual events</li>
            <li>Professionals, developers, decision-makers</li>
            <li>Strong repeat attendance, growing monthly</li>
          </ul>
        </div>

        <!-- Speakers -->
        <div class="card-dark p-7 md:p-8 flex flex-col gap-4">
          <svg class="w-7 h-7 text-secondary-light" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8" />
          </svg>
          <h3 class="h-card text-white">Speakers</h3>
          <ul class="flex flex-col gap-2 text-[15px] text-text-on-dark">
            <li><strong class="text-white">2-3</strong> expert speakers at each event</li>
            <li>Recognised <strong class="text-white">Microsoft MVPs</strong></li>
            <li>Industry specialists</li>
            <li>Power BI, Power Apps, Power Automate, AI</li>
          </ul>
        </div>

        <!-- Community -->
        <div class="card-dark p-7 md:p-8 flex flex-col gap-4">
          <svg class="w-7 h-7 text-accent-soft" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.75 5.7 3.75 9s-1.25 6.3-3.75 9c-2.5-2.7-3.75-5.7-3.75-9S9.5 5.7 12 3z" />
          </svg>
          <h3 class="h-card text-white">Community</h3>
          <ul class="flex flex-col gap-2 text-[15px] text-text-on-dark">
            <li><strong class="text-white">385+</strong> followers on LinkedIn</li>
            <li>Team has <strong class="text-white">16,000+</strong> combined followers</li>
            <li><strong class="text-white">2,000+</strong> impressions per post</li>
            <li>Active event promotion &amp; sponsor shout-outs</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Sponsorship packages -->
  <section class="section" aria-labelledby="packages-heading">
    <div class="wrap flex flex-col gap-10">
      <div class="max-w-3xl flex flex-col gap-4">
        <span class="kicker">Packages</span>
        <h2 id="packages-heading" class="h-section text-text">Sponsorship Packages</h2>
        <p class="lede">Please speak to a member of the team for package availability.</p>
      </div>

      <div class="grid gap-5 md:grid-cols-3 items-stretch">
        {tiers.map((tier) => (
          <div class:list={['card overflow-hidden flex flex-col relative', tier.highlight && 'border-secondary']}>
            {tier.highlight && (
              <span class="absolute top-5 right-5 pill pill-free">Best value</span>
            )}
            <div class:list={['px-7 pt-7 pb-6 flex flex-col gap-2 border-b border-border', tier.highlight ? 'bg-secondary-tint' : 'bg-surface-muted']}>
              <h3 class="h-card text-text">{tier.name}</h3>
              <div class="flex items-baseline gap-1.5">
                <span class="font-display font-extrabold tracking-tight text-[36px] leading-none text-text">{tier.price}</span>
                <span class="text-text-light">{tier.per}</span>
              </div>
              <span class="text-sm text-text-light">{tier.commitment}</span>
            </div>
            <ul class="p-7 flex flex-col gap-3 text-[15px] leading-relaxed text-text-light">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <svg class:list={['w-5 h-5 mt-0.5 shrink-0', tier.highlight ? 'text-secondary-dark' : 'text-primary']} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                  <span set:html={feature} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="card-tint p-7 md:p-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <p class="lede max-w-xl">Download our full sponsorship pack for more details, or get in touch to discuss options.</p>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/documents/NPPUG Sponsorship pack.pdf" target="_blank" class="btn btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14" /></svg>
            Download Sponsorship Pack<span class="sr-only"> (opens in new tab)</span>
          </a>
          <a href="/contact" class="btn btn-ghost">Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Current sponsors -->
  <section class="section section-white" aria-labelledby="current-heading">
    <div class="wrap">
      <div class="max-w-3xl flex flex-col gap-4">
        <span class="kicker">Already on board</span>
        <h2 id="current-heading" class="h-section text-text">Join Our Sponsors</h2>
        <p class="lede">See who's already supporting the Norfolk Power Platform community.</p>
        <a href="/sponsors" class="link-arrow pt-1">
          View Current Sponsors
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
