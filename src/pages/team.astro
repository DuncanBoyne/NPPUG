---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const allSpeakers = await getCollection('speakers');
const teamMembers = allSpeakers.filter(s => s.data.isOrganizer);
---

<BaseLayout title="Our Team" description="Meet the team behind the Norfolk Power Platform User Group.">
  <Hero
    kicker="The volunteers"
    title="Our Team"
    subtitle="Meet the volunteers who make Norfolk Power Platform User Group possible."
  />

  <section class="section" aria-label="Team members">
    <div class="wrap">
      <div class="max-w-5xl flex flex-col gap-6">
        {teamMembers.map(async (member) => {
          const { Content } = await member.render();
          const initials = member.data.name.split(' ').map(n => n[0]).join('').toUpperCase();
          return (
            <article class="card overflow-hidden grid md:grid-cols-[280px_1fr]">
              <!-- Photo -->
              <div class="bg-primary-tint p-8 md:p-10 flex items-center justify-center">
                {member.data.image ? (
                  <img
                    src={member.data.image}
                    alt={member.data.name}
                    class="w-40 h-40 md:w-44 md:h-44 rounded-full object-cover border-4 border-surface"
                  />
                ) : (
                  <div class="w-40 h-40 md:w-44 md:h-44 rounded-full bg-surface flex items-center justify-center font-display font-bold text-5xl text-primary-deep border-4 border-surface" aria-hidden="true">
                    {initials}
                  </div>
                )}
              </div>

              <!-- Details -->
              <div class="p-7 md:p-10 flex flex-col gap-5">
                <div class="flex flex-col gap-1">
                  <h2 class="h-card text-[26px] text-text">{member.data.name}</h2>
                  <p class="text-primary font-semibold text-[17px]">{member.data.title}</p>
                  {member.data.company && (
                    <p class="text-text-light">{member.data.company}</p>
                  )}
                </div>

                <div class="prose prose-sm max-w-none text-text-light">
                  <Content />
                </div>

                <!-- Social Links -->
                <div class="flex flex-wrap gap-x-6 gap-y-3 pt-1">
                  {member.data.linkedin && (
                    <a
                      href={member.data.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-[15px] font-semibold text-primary hover:text-primary-dark transition-colors"
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                      </svg>
                      LinkedIn<span class="sr-only"> (opens in new tab)</span>
                    </a>
                  )}
                  {member.data.twitter && (
                    <a
                      href={member.data.twitter}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-[15px] font-semibold text-primary hover:text-primary-dark transition-colors"
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                      </svg>
                      Twitter/X<span class="sr-only"> (opens in new tab)</span>
                    </a>
                  )}
                  {member.data.github && (
                    <a
                      href={member.data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-[15px] font-semibold text-primary hover:text-primary-dark transition-colors"
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                      GitHub<span class="sr-only"> (opens in new tab)</span>
                    </a>
                  )}
                  {member.data.website && (
                    <a
                      href={member.data.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-[15px] font-semibold text-primary hover:text-primary-dark transition-colors"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.75 5.7 3.75 9s-1.25 6.3-3.75 9c-2.5-2.7-3.75-5.7-3.75-9S9.5 5.7 12 3z" />
                      </svg>
                      Website<span class="sr-only"> (opens in new tab)</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Join the Team CTA -->
  <section class="section section-white" aria-labelledby="help-heading">
    <div class="wrap">
      <div class="max-w-3xl flex flex-col gap-5">
        <span class="kicker">Volunteer</span>
        <h2 id="help-heading" class="h-section text-text">Want to Help?</h2>
        <p class="lede">
          We're always looking for volunteers to help organize events, manage social media, or contribute in other ways. If you're passionate about Power Platform and community building, we'd love to hear from you.
        </p>
        <div class="pt-2">
          <a href="/contact" class="btn btn-primary btn-lg">
            Get in Touch
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
