---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import EventCard from '../../components/EventCard.astro';
import EventCalendar from '../../components/EventCalendar.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const allSpeakers = await getCollection('speakers');
const speakerMap = Object.fromEntries(allSpeakers.map(s => [s.slug, s.data.name]));

// Calculate if event is past based on the event date (use endDate if available, otherwise date)
const now = new Date();
const isEventPast = (event: typeof allEvents[0]) => {
  const eventEnd = event.data.endDate || event.data.date;
  return eventEnd < now;
};

const upcomingEvents = allEvents
  .filter(event => !isEventPast(event))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const pastEvents = allEvents
  .filter(event => isEventPast(event))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Events" description="Upcoming and past events from the Norfolk Power Platform User Group.">
  <Hero
    kicker="What's on"
    title="Events"
    subtitle="Join us for our regular meetups featuring technical demos, guest speakers, and networking."
  />

  <!-- Event Calendar & Upcoming Events -->
  <section class="section" aria-labelledby="upcoming-heading">
    <div class="wrap">
      <div class="grid gap-10 lg:grid-cols-3 lg:gap-8">
        <!-- Calendar Sidebar -->
        <div class="lg:col-span-1">
          <EventCalendar />
        </div>

        <!-- Upcoming Events -->
        <div class="lg:col-span-2 flex flex-col gap-8">
          <div class="flex flex-col gap-4">
            <span class="kicker">Coming up</span>
            <h2 id="upcoming-heading" class="h-section text-text">Upcoming Events</h2>
          </div>

          {upcomingEvents.length > 0 ? (
            <div class="grid gap-5 md:grid-cols-2">
              {upcomingEvents.map((event) => (
                <EventCard
                  title={event.data.title}
                  date={event.data.date}
                  endDate={event.data.endDate}
                  location={event.data.location}
                  venue={event.data.venue}
                  description={event.data.description}
                  slug={event.slug}
                  isPast={false}
                  speakers={event.data.speakers.map(s => speakerMap[s] || s)}
                />
              ))}
            </div>
          ) : (
            <div class="card p-8 md:p-10 text-center flex flex-col gap-3">
              <p class="text-lg font-semibold text-text">No upcoming events scheduled at the moment.</p>
              <p class="text-[15px] text-text-light">
                Follow us on{' '}
                <a
                  href="https://www.linkedin.com/company/norfolk-power-platform-user-group/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary font-semibold hover:text-primary-dark"
                >
                  LinkedIn<span class="sr-only"> (opens in new tab)</span>
                </a>{' '}
                to be notified when new events are announced.
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Past Events -->
  {pastEvents.length > 0 && (
    <section id="past" class="section section-white" aria-labelledby="past-heading">
      <div class="wrap flex flex-col gap-9">
        <div class="flex flex-col gap-4">
          <span class="kicker">Looking back</span>
          <h2 id="past-heading" class="h-section text-text">Past Events</h2>
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {pastEvents.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              endDate={event.data.endDate}
              location={event.data.location}
              venue={event.data.venue}
              description={event.data.description}
              slug={event.slug}
              isPast={true}
              speakers={event.data.speakers.map(s => speakerMap[s] || s)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="section section-dark" aria-labelledby="speak-heading">
    <div class="wrap flex flex-col items-center text-center gap-5">
      <span class="kicker kicker-on-dark">Speakers</span>
      <h2 id="speak-heading" class="h-section text-white max-w-2xl">Want to Speak?</h2>
      <p class="lede text-text-on-dark max-w-2xl">
        We're always looking for speakers to share their knowledge and experiences. First-time speakers welcome!
      </p>
      <div class="pt-2">
        <a
          href="https://sessionize.com/norfolk-power-platform-user-group-IP/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg"
        >
          Submit a Talk on Sessionize<span class="sr-only"> (opens in new tab)</span>
          <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
