---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
---

<BaseLayout title="Knowledge Base" description="Power Platform guides, tutorials, and documentation from the Norfolk community.">
  <Hero
    kicker="Knowledge base"
    title="Knowledge Base"
    subtitle="Guides, tutorials, and documentation to help you master the Power Platform."
  />

  <section class="section">
    <div class="wrap">
      <div class="max-w-3xl mx-auto">
        <div class="card-tint p-8 md:p-12 flex flex-col items-center text-center gap-5">
          <svg class="w-12 h-12 text-primary" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <h2 class="font-display font-extrabold tracking-tight text-[28px] md:text-[32px] leading-[1.1] text-text">Coming Soon</h2>
          <p class="lede">
            We're building a comprehensive knowledge base with guides, tutorials, and best practices for the Power Platform.
          </p>
          <p class="text-[15px] text-text-light">
            In the meantime, check out our <a href="/resources" class="text-primary font-semibold hover:text-primary-dark">Resources</a> page for presentations and materials from past events.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Topics Preview -->
  <section class="section section-white" aria-labelledby="topics-heading">
    <div class="wrap flex flex-col gap-10">
      <div class="max-w-2xl flex flex-col gap-4">
        <span class="kicker">What is coming</span>
        <h2 id="topics-heading" class="h-section text-text">Topics We'll Cover</h2>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <div class="card p-6 md:p-7 flex flex-col gap-4">
          <div class="w-12 h-12 bg-surface-muted rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-power-apps" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3l9 4.5-9 4.5-9-4.5L12 3z" /><path d="M3 12l9 4.5 9-4.5" /><path d="M3 16.5L12 21l9-4.5" />
            </svg>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="h-card text-[20px] text-text">Power Apps</h3>
            <p class="text-[15px] leading-relaxed text-text-light">Canvas apps, model-driven apps, components, and best practices.</p>
          </div>
        </div>

        <div class="card p-6 md:p-7 flex flex-col gap-4">
          <div class="w-12 h-12 bg-surface-muted rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-power-automate" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M13 3L5 13h6l-1 8 8-10h-6l1-8z" />
            </svg>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="h-card text-[20px] text-text">Power Automate</h3>
            <p class="text-[15px] leading-relaxed text-text-light">Cloud flows, desktop flows, triggers, actions, and automation patterns.</p>
          </div>
        </div>

        <div class="card p-6 md:p-7 flex flex-col gap-4">
          <div class="w-12 h-12 bg-surface-muted rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-power-bi" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="4" y="10" width="4" height="10" rx="1" /><rect x="10" y="4" width="4" height="16" rx="1" /><rect x="16" y="13" width="4" height="7" rx="1" />
            </svg>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="h-card text-[20px] text-text">Power BI</h3>
            <p class="text-[15px] leading-relaxed text-text-light">Data modeling, DAX, visualizations, and report design.</p>
          </div>
        </div>

        <div class="card p-6 md:p-7 flex flex-col gap-4">
          <div class="w-12 h-12 bg-surface-muted rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-power-pages" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18" />
            </svg>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="h-card text-[20px] text-text">Power Pages</h3>
            <p class="text-[15px] leading-relaxed text-text-light">External-facing websites, portals, and web development.</p>
          </div>
        </div>

        <div class="card p-6 md:p-7 flex flex-col gap-4">
          <div class="w-12 h-12 bg-surface-muted rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-copilot-studio" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12a8 8 0 0 1-11.6 7.1L4 21l1.9-5.4A8 8 0 1 1 21 12z" />
            </svg>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="h-card text-[20px] text-text">Copilot Studio</h3>
            <p class="text-[15px] leading-relaxed text-text-light">Chatbots, conversational AI, and intelligent assistants.</p>
          </div>
        </div>

        <div class="card p-6 md:p-7 flex flex-col gap-4">
          <div class="w-12 h-12 bg-surface-muted rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 5-5" />
            </svg>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="h-card text-[20px] text-text">Best Practices</h3>
            <p class="text-[15px] leading-relaxed text-text-light">Governance, ALM, security, and enterprise patterns.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contribute CTA -->
  <section class="section section-dark" aria-labelledby="contribute-heading">
    <div class="wrap flex flex-col gap-5 max-w-2xl">
      <span class="kicker kicker-on-dark">Get involved</span>
      <h2 id="contribute-heading" class="h-section text-white">Want to Contribute?</h2>
      <p class="lede text-text-on-dark">
        Have expertise to share? We're looking for community members to help build our knowledge base.
      </p>
      <div class="pt-2">
        <a
          href="/contact"
          class="btn btn-primary btn-lg"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
