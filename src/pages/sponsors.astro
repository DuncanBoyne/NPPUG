---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="Our Sponsors" description="Meet the sponsors who support the Norfolk Power Platform User Group.">
  <Hero
    kicker="Sponsors"
    title="Our Sponsors"
    subtitle="Thank you to the organisations who make our community possible."
  />

  <!-- Current Sponsors -->
  <section class="section" aria-labelledby="current-sponsors-heading">
    <div class="wrap flex flex-col gap-10">
      <div class="max-w-2xl flex flex-col gap-4">
        <span class="kicker">Who keeps it free</span>
        <h2 id="current-sponsors-heading" class="h-section text-text">Current Sponsors</h2>
      </div>

      <div class="max-w-md">
        <div class="card p-8 md:p-10 flex flex-col items-center text-center gap-6">
          <div class="h-20 flex items-center justify-center">
            <img src="/images/sponsors/GTPTech.png" alt="GTP Tech Recruitment" class="max-h-full max-w-full object-contain" />
          </div>
          <span class="pill pill-free">Official Recruitment Partner</span>

          <div class="flex flex-col gap-3 text-[15px]">
            <a href="https://gtptech.co.uk/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 text-text-light hover:text-primary transition-colors">
              <svg class="w-[18px] h-[18px] text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.5 5.7 3.5 9s-1 6.3-3.5 9c-2.5-2.7-3.5-5.7-3.5-9s1-6.3 3.5-9z" />
              </svg>
              gtptech.co.uk<span class="sr-only"> (opens in new tab)</span>
            </a>
            <a href="mailto:recruitment@gtptech.co.uk" class="flex items-center justify-center gap-2 text-text-light hover:text-primary transition-colors">
              <svg class="w-[18px] h-[18px] text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 8l9 5.5L21 8" />
              </svg>
              recruitment@gtptech.co.uk
            </a>
            <a href="tel:07307075779" class="flex items-center justify-center gap-2 text-text-light hover:text-primary transition-colors">
              <svg class="w-[18px] h-[18px] text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 4h3.5l1.5 4.5-2 1.2a11 11 0 0 0 6.3 6.3l1.2-2 4.5 1.5V19a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />
              </svg>
              07307 075779
            </a>
          </div>

          <a
            href="https://www.linkedin.com/company/gtp-tech/"
            target="_blank"
            rel="noopener noreferrer"
            class="link-arrow"
          >
            <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9.5h4V21H3zM9.5 9.5H13.3v1.6h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.2c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4z" />
            </svg>
            View on LinkedIn<span class="sr-only"> (opens in new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Become a Sponsor CTA -->
  <section class="section section-dark" aria-labelledby="sponsor-cta-heading">
    <div class="wrap flex flex-col gap-6 max-w-3xl">
      <span class="kicker kicker-on-dark">Become a sponsor</span>
      <h2 id="sponsor-cta-heading" class="h-section text-white">Interested in Sponsoring?</h2>
      <p class="lede text-text-on-dark">
        Join our sponsors and reach Norfolk's thriving Power Platform community.
      </p>
      <div class="pt-2">
        <a href="/sponsorship" class="btn btn-amber btn-lg">
          View Sponsorship Packages
          <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
