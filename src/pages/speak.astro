---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { SITE } from '../config';
---

<BaseLayout
  title="Speak at NPPUG"
  description="Give a talk at the Norfolk Power Platform User Group. First-time speakers get a short slot, a friendly room, and help preparing."
>
  <Hero
    kicker="Speakers"
    title="Speak at NPPUG"
    subtitle="Share what you've built, what broke, and what you learned — to the friendliest room in Norfolk."
    showCta={true}
    ctaText="Submit a Talk on Sessionize"
    ctaLink={SITE.sessionize}
  />

  <!-- Why speak -->
  <section class="section" aria-labelledby="why-speak-heading">
    <div class="wrap flex flex-col gap-10">
      <div class="max-w-3xl flex flex-col gap-4">
        <span class="kicker">Why speak here</span>
        <h2 id="why-speak-heading" class="h-section text-text">Why Speak Here?</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        <div class="card p-7 md:p-8 flex flex-col gap-3">
          <h3 class="h-card text-text">A real audience, low stakes</h3>
          <p class="text-[15px] leading-relaxed text-text-light">
            20+ practitioners who want you to succeed. Evening meetup, two talks a night —
            the perfect room to try new material or speak for the first time.
          </p>
        </div>
        <div class="card p-7 md:p-8 flex flex-col gap-3">
          <h3 class="h-card text-text">We promote you properly</h3>
          <p class="text-[15px] leading-relaxed text-text-light">
            Your session and bio go on our website and LinkedIn. We take photos while you present
            and send them to you afterwards — content for your own profile.
          </p>
        </div>
        <div class="card p-7 md:p-8 flex flex-col gap-3">
          <h3 class="h-card text-text">A step to bigger stages</h3>
          <p class="text-[15px] leading-relaxed text-text-light">
            NPPUG speakers go on to the East of England Power Platform Summit and user groups
            and conferences across the UK. This is where that starts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- First-time speakers -->
  <section class="section section-white" aria-labelledby="first-time-heading">
    <div class="wrap">
      <div class="card-tint p-7 md:p-10 flex flex-col gap-6">
        <div class="max-w-3xl flex flex-col gap-4">
          <span class="kicker">First-time speakers</span>
          <h2 id="first-time-heading" class="h-section text-text">Never spoken before? Perfect.</h2>
          <p class="lede">
            Every speaker you've ever seen had a first talk. We'd love yours to be with us, so we make it easy:
          </p>
        </div>
        <ul class="grid gap-5 md:grid-cols-3">
          <li class="card p-6 md:p-7 flex items-start gap-3 text-[15px] leading-relaxed text-text-light">
            <svg class="w-6 h-6 text-primary mt-px shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 5-5" />
            </svg>
            <span><strong class="text-text">Start with 10–15 minutes.</strong> A lightning talk about one thing you built or one problem you solved is a brilliant first session.</span>
          </li>
          <li class="card p-6 md:p-7 flex items-start gap-3 text-[15px] leading-relaxed text-text-light">
            <svg class="w-6 h-6 text-primary mt-px shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 5-5" />
            </svg>
            <span><strong class="text-text">We'll mentor you.</strong> An experienced NPPUG speaker will help you shape the talk, review your slides, and do a practice run if you want one.</span>
          </li>
          <li class="card p-6 md:p-7 flex items-start gap-3 text-[15px] leading-relaxed text-text-light">
            <svg class="w-6 h-6 text-primary mt-px shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 5-5" />
            </svg>
            <span><strong class="text-text">You don't need to be an expert.</strong> "Here's what I tried, here's what went wrong, here's what I'd do differently" is often the most useful talk of the night.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- What we need -->
  <section class="section" aria-labelledby="what-we-need-heading">
    <div class="wrap flex flex-col gap-10">
      <div class="max-w-3xl flex flex-col gap-4">
        <span class="kicker">Submitting a talk</span>
        <h2 id="what-we-need-heading" class="h-section text-text">What We Need From You</h2>
      </div>
      <ol class="grid gap-5 md:grid-cols-3">
        <li class="card p-7 md:p-8 flex flex-col gap-3">
          <h3 class="h-card text-text">A title</h3>
          <p class="text-[15px] leading-relaxed text-text-light">Clear beats clever. Say what the audience will get.</p>
        </li>
        <li class="card p-7 md:p-8 flex flex-col gap-3">
          <h3 class="h-card text-text">A short abstract</h3>
          <p class="text-[15px] leading-relaxed text-text-light">A few sentences on what you'll cover and who it's for.</p>
        </li>
        <li class="card p-7 md:p-8 flex flex-col gap-3">
          <h3 class="h-card text-text">A line about you</h3>
          <p class="text-[15px] leading-relaxed text-text-light">Your bio and a photo — we use these to promote your session.</p>
        </li>
      </ol>
      <p class="text-[17px] leading-relaxed text-text-light max-w-3xl">
        Topics we love: Power Apps, Power Automate, Power BI, Fabric, Copilot Studio, Dynamics 365,
        Dataverse, real project stories, career journeys, and soft skills. No sales pitches — that's
        our promise to the audience.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark" aria-labelledby="cta-heading">
    <div class="wrap">
      <div class="max-w-3xl flex flex-col gap-5">
        <span class="kicker kicker-on-dark">Submit a talk</span>
        <h2 id="cta-heading" class="h-section text-white">Ready When You Are</h2>
        <p class="lede text-text-on-dark">
          Submit a talk idea — even a rough one — and we'll take it from there.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a
            href={SITE.sessionize}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg"
          >
            Submit on Sessionize<span class="sr-only"> (opens in new tab)</span>
          </a>
          <a
            href="/contact"
            class="btn btn-ghost-on-dark btn-lg"
          >
            Talk It Through First
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
