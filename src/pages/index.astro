---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import FirstMeetup from '../components/FirstMeetup.astro';
import GetInvolved from '../components/GetInvolved.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';
import { SITE, STATS } from '../config';

const allEvents = await getCollection('events');

const now = new Date();
const isEventPast = (event: typeof allEvents[0]) => {
  const eventEnd = event.data.endDate || event.data.date;
  return eventEnd < now;
};

const upcomingEvents = allEvents
  .filter(event => !isEventPast(event))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const nextEvent = upcomingEvents[0];
const comingUp = upcomingEvents.slice(0, 3);

const allSpeakers = await getCollection('speakers');
const speakerMap = Object.fromEntries(allSpeakers.map(s => [s.slug, s.data]));

// Talks on the ticket: explicit sessions first, else linked speaker profiles.
type Talk = { title: string; speaker: string; image?: string };
const talks: Talk[] = nextEvent
  ? nextEvent.data.sessions.length > 0
    ? nextEvent.data.sessions
    : nextEvent.data.speakers
        .map(slug => speakerMap[slug])
        .filter(Boolean)
        .map(s => ({ title: s.title, speaker: s.name, image: s.image }))
  : [];

const initials = (name: string) => name.split(' ').map(n => n[0]).join('').toUpperCase();

const nextDay = nextEvent?.data.date.getUTCDate();
const nextMonth = nextEvent?.data.date.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).slice(0, 3).toUpperCase();
const nextWeekday = nextEvent?.data.date.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
const nextStart = nextEvent?.data.date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });
const nextEnd = nextEvent?.data.endDate?.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });
const nextIsOnline = nextEvent ? /online|virtual/i.test(`${nextEvent.data.venue} ${nextEvent.data.location}`) : false;
const nextPlace = nextEvent ? (nextIsOnline ? 'Online, on Teams' : `${nextEvent.data.venue}, ${nextEvent.data.location}`) : '';
const nextCtaUrl = nextEvent ? (nextEvent.data.registrationUrl ?? `/events/${nextEvent.slug}`) : '/events';
const nextCtaLabel = nextEvent?.data.registrationUrl?.includes('meetup.com') ? 'Register on Meetup' : 'Register free';

// Outcome-framed topic tiles: product + what attending helps you do.
const topics = [
  { name: 'Power Apps', outcome: 'Build apps without waiting for IT', color: 'bg-power-apps' },
  { name: 'Power Automate', outcome: 'Give hours back to your team', color: 'bg-power-automate' },
  { name: 'Power BI', outcome: "Answer questions your reports can't", color: 'bg-power-bi' },
  { name: 'Power Pages', outcome: 'Put your data on the web, securely', color: 'bg-power-pages' },
  { name: 'Copilot Studio', outcome: 'Build agents that actually help', color: 'bg-copilot-studio' },
  { name: 'Dynamics 365', outcome: 'CRM and ERP that fit your business', color: 'bg-secondary' },
  { name: 'Dataverse', outcome: 'One secure home for your data', color: 'bg-primary' },
  { name: 'Soft skills', outcome: 'Present, persuade and lead', color: 'bg-accent' },
  { name: 'Careers', outcome: 'Meet local employers and peers', color: 'bg-secondary-dark' },
  { name: 'And more', outcome: 'AI, Fabric, Azure and beyond', color: 'bg-ink' },
];
---

<BaseLayout title="Home" description={SITE.tagline}>
  <!-- ============ 1. Hero: identity + next meetup ticket ============ -->
  <section class="wrap pt-10 pb-14 md:pt-14 md:pb-[72px] grid gap-10 lg:grid-cols-12 lg:gap-8 lg:items-center">
    <div class="lg:col-span-7 flex flex-col gap-6 md:gap-7">
      <span class="kicker">Norfolk's Microsoft community</span>
      <h1 class="h-display text-text">Free monthly meetups in Norwich for people who build with Microsoft.</h1>
      <p class="lede max-w-[560px]">
        Power Platform, Power BI, Fabric, Dynamics 365 and Copilot. Real speakers, real demos, free pizza, no sales pitches. From your first flow to enterprise architecture.
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <a href={nextCtaUrl} class="btn btn-primary btn-lg" target={nextEvent?.data.registrationUrl ? '_blank' : undefined} rel={nextEvent?.data.registrationUrl ? 'noopener noreferrer' : undefined}>
          {nextEvent ? 'Join the next meetup, free' : 'See our events'}
          <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a href="#first-meetup-heading" class="btn btn-ghost btn-lg">First time? What to expect</a>
      </div>
      <div class="flex items-center gap-3 pt-1">
        <div class="flex" aria-hidden="true">
          <span class="w-8 h-8 rounded-full bg-power-apps border-2 border-background"></span>
          <span class="w-8 h-8 rounded-full bg-power-automate border-2 border-background -ml-2.5"></span>
          <span class="w-8 h-8 rounded-full bg-power-bi border-2 border-background -ml-2.5"></span>
          <span class="w-8 h-8 rounded-full bg-power-pages border-2 border-background -ml-2.5"></span>
        </div>
        <span class="text-[15px] text-text-light">Makers, analysts, admins and architects from across Norfolk</span>
      </div>
    </div>

    <!-- Next meetup ticket -->
    <aside class="lg:col-span-5 card rounded-3xl overflow-hidden shadow-[0_24px_48px_-24px_rgba(30,27,46,0.25)] flex flex-col" aria-labelledby="next-meetup-heading">
      <div class="flex items-center justify-between px-6 md:px-7 pt-5 md:pt-6 pb-4">
        <span class="kicker">Next meetup</span>
        <span class="pill pill-free">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
          Free
        </span>
      </div>

      {nextEvent ? (
        <>
          <div class="flex items-start gap-5 px-6 md:px-7 pb-6">
            <div class="w-[84px] h-[92px] rounded-2xl bg-primary-tint flex flex-col items-center justify-center shrink-0" aria-hidden="true">
              <span class="font-display font-extrabold text-[40px] leading-none text-primary-deep">{nextDay}</span>
              <span class="text-[13px] font-bold tracking-[0.1em] text-primary mt-1">{nextMonth}</span>
            </div>
            <div class="flex flex-col gap-2 min-w-0">
              <h2 id="next-meetup-heading" class="h-card text-[26px] text-text">
                <a href={`/events/${nextEvent.slug}`} class="hover:text-primary transition-colors">{nextEvent.data.title.replace(/\s\d{4}\s/, ' ')}</a>
              </h2>
              <div class="flex items-center gap-2 text-[15px] text-text-light">
                <svg class="w-[18px] h-[18px] text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                <span>{nextWeekday}, {nextStart}{nextEnd && ` to ${nextEnd}`}</span>
              </div>
              <div class="flex items-center gap-2 text-[15px] text-text-light">
                {nextIsOnline ? (
                  <svg class="w-[18px] h-[18px] text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="13" rx="2" /><path d="M8 21h8" /></svg>
                ) : (
                  <svg class="w-[18px] h-[18px] text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6-5.5-6-10a6 6 0 0 1 12 0c0 4.5-6 10-6 10z" /><circle cx="12" cy="11" r="2.5" /></svg>
                )}
                <span>{nextPlace}</span>
              </div>
            </div>
          </div>

          <!-- perforation -->
          <div class="relative mx-5 border-t-2 border-dashed border-border" aria-hidden="true">
            <span class="absolute -left-8 -top-3 w-6 h-6 rounded-full bg-background border border-border"></span>
            <span class="absolute -right-8 -top-3 w-6 h-6 rounded-full bg-background border border-border"></span>
          </div>

          <div class="flex flex-col gap-4 px-6 md:px-7 pt-6 pb-6 md:pb-7">
            {talks.length > 0 ? (
              <>
                <span class="text-[13px] font-bold tracking-[0.1em] uppercase text-text-light">{talks.length === 1 ? 'The talk' : `${talks.length === 2 ? 'Two' : talks.length} talks`}</span>
                <ul class="flex flex-col gap-4">
                  {talks.map((talk, i) => (
                    <li class="flex items-center gap-3.5">
                      <div class:list={['w-14 h-14 rounded-full overflow-hidden shrink-0 flex items-end justify-center', i % 2 === 0 ? 'bg-primary-tint' : 'bg-secondary-tint']} aria-hidden="true">
                        {talk.image ? (
                          <img src={talk.image} alt="" class="w-12 h-[60px] object-cover object-top" />
                        ) : (
                          <span class="w-14 h-14 flex items-center justify-center font-display font-bold text-primary-deep">{initials(talk.speaker)}</span>
                        )}
                      </div>
                      <div class="flex flex-col gap-0.5">
                        <span class="font-bold text-text">{talk.title}</span>
                        <span class="text-sm text-text-light">{talk.speaker}</span>
                      </div>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <p class="text-[15px] text-text-light">{nextEvent.data.description}</p>
            )}
            <div class="flex gap-2.5 pt-1">
              <a href={nextCtaUrl} class="btn btn-primary flex-1 whitespace-nowrap px-4 text-[15px]" target={nextEvent.data.registrationUrl ? '_blank' : undefined} rel={nextEvent.data.registrationUrl ? 'noopener noreferrer' : undefined}>
                {nextCtaLabel}{nextEvent.data.registrationUrl && <span class="sr-only"> (opens in new tab)</span>}
              </a>
              <a href={`/events/${nextEvent.slug}`} class="btn btn-ghost flex-1 whitespace-nowrap px-4 text-[15px]">Event details</a>
            </div>
          </div>
        </>
      ) : (
        <div class="px-6 md:px-7 pb-7 flex flex-col gap-4">
          <h2 id="next-meetup-heading" class="h-card text-text">Next date announced soon</h2>
          <p class="text-[15px] text-text-light">We meet every month in Norwich. The next event goes up here first. Follow us on LinkedIn or check the events page so you don't miss it.</p>
          <div class="flex gap-2.5">
            <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-primary flex-1">Follow on LinkedIn<span class="sr-only"> (opens in new tab)</span></a>
            <a href="/events" class="btn btn-ghost flex-1">All events</a>
          </div>
        </div>
      )}
    </aside>
  </section>

  <!-- ============ 2. Proof strip ============ -->
  <section class="wrap" aria-label="Community facts">
    <dl class="border-y border-border grid grid-cols-2 md:grid-cols-4">
      {STATS.map((stat, i) => (
        <div class:list={[
          'py-5 md:py-7 flex flex-col gap-1',
          i % 2 === 0 ? 'pr-4 md:pr-6' : 'pl-4 md:pl-6',
          'md:px-6 md:first:pl-0 md:last:pr-0',
          i < 2 && 'border-b border-border md:border-b-0',
          (i % 2 === 0) && 'border-r border-border',
          i === 2 && 'md:border-r',
          i === 1 && 'md:border-r',
        ]}>
          <dt class="order-2 text-[15px] text-text-light">{stat.label}</dt>
          <dd class="order-1 font-display font-extrabold text-[26px] md:text-[32px] tracking-tight text-text">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ============ 3. First meetup promise ============ -->
  <FirstMeetup />

  <!-- ============ 4. What you'll get out of it ============ -->
  <section class="section section-white" aria-labelledby="topics-heading">
    <div class="wrap flex flex-col gap-10">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="max-w-2xl flex flex-col gap-4">
          <span class="kicker">What you will get out of it</span>
          <h2 id="topics-heading" class="h-section text-text">Every session is about doing something better at work.</h2>
        </div>
        <a href="/events#past" class="link-arrow shrink-0">
          See past sessions
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
      <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-4">
        {topics.map((topic) => (
          <li class="card-muted p-4 md:p-[22px] flex flex-col gap-3.5">
            <span class:list={['w-3.5 h-3.5 rounded', topic.color]} aria-hidden="true"></span>
            <div class="flex flex-col gap-1">
              <span class="font-bold text-[15px] md:text-base text-text">{topic.name}</span>
              <span class="text-[13px] md:text-sm leading-snug text-text-light">{topic.outcome}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 5. Coming up ============ -->
  {comingUp.length > 0 && (
    <section class="section" aria-labelledby="coming-up-heading">
      <div class="wrap flex flex-col gap-9">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div class="flex flex-col gap-4">
            <span class="kicker">Coming up</span>
            <h2 id="coming-up-heading" class="h-section text-text">{comingUp.length === 1 ? 'Put it in your diary.' : `Put the next ${comingUp.length === 2 ? 'two' : 'three'} in your diary.`}</h2>
          </div>
          <a href="/events" class="link-arrow shrink-0">
            All events
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {comingUp.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              endDate={event.data.endDate}
              location={event.data.location}
              venue={event.data.venue}
              description={event.data.description}
              slug={event.slug}
              isPast={false}
              speakers={event.data.sessions.length > 0 ? event.data.sessions.map(s => s.speaker) : event.data.speakers.map(s => speakerMap[s]?.name || s)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ 6. Get involved: speak / sponsor / volunteer ============ -->
  <GetInvolved />

  <!-- ============ 7. Sponsors + built in Norfolk ============ -->
  <section class="wrap section grid gap-6 lg:grid-cols-2 lg:gap-8" aria-label="Sponsors and about">
    <div class="card rounded-3xl p-7 md:p-10 flex flex-col gap-5">
      <span class="kicker">Sponsors</span>
      <h2 class="font-display font-extrabold tracking-tight text-[28px] md:text-[32px] leading-[1.1] text-text">Our sponsors keep every event free.</h2>
      <p class="text-text-light">Please thank them when you see them.</p>
      <a href="https://gtptech.co.uk/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-5 border border-dashed border-border-strong rounded-2xl hover:border-primary transition-colors">
        <img src="/images/sponsors/GTPTech.png" alt="GTP Tech Recruitment" class="h-11 w-auto max-w-[140px] object-contain" />
        <span class="flex flex-col gap-0.5">
          <span class="font-bold text-text">GTP Tech Recruitment</span>
          <span class="text-sm text-text-light">Official recruitment partner<span class="sr-only"> (opens in new tab)</span></span>
        </span>
      </a>
      <div class="mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-1">
        <a href="/sponsorship" class="link-arrow">
          Become a sponsor
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="/sponsors" class="link-arrow text-text-light hover:text-text">Meet our sponsors</a>
      </div>
    </div>

    <div class="card-tint p-7 md:p-10 flex flex-col gap-5 relative overflow-hidden">
      <img src="/images/Logo.png" alt="" class="absolute -right-10 -bottom-8 w-[260px] opacity-[0.18] -rotate-12 pointer-events-none" aria-hidden="true" />
      <span class="kicker">Built in Norfolk, for Norfolk</span>
      <h2 class="font-display font-extrabold tracking-tight text-[28px] md:text-[32px] leading-[1.1] text-text max-w-[420px]">We are also the team behind the East of England Power Platform Summit.</h2>
      <p class="text-text-light max-w-[420px]">Founded in {SITE.founded} by volunteers. From a chance meeting, to a user group, to a flagship two-day summit.</p>
      <div class="mt-auto flex flex-wrap gap-3 pt-1 relative">
        <a href="/about" class="btn btn-primary btn-sm">Our story</a>
        <a href={SITE.eoepps} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm border-primary-soft">EoEPPS summit<span class="sr-only"> (opens in new tab)</span></a>
      </div>
    </div>
  </section>

  <!-- ============ 8. Newsletter ============ -->
  <NewsletterSignup />
</BaseLayout>
