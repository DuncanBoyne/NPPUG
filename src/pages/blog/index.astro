---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Blog" description="News, updates, and insights from the Norfolk Power Platform User Group.">
  <Hero
    kicker="Blog"
    title="Blog"
    subtitle="News, updates, and insights from our community."
  />

  <section class="section">
    <div class="wrap">
      {posts.length > 0 ? (
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="card overflow-hidden flex flex-col transition-shadow hover:shadow-[0_24px_48px_-28px_rgba(30,27,46,0.35)]">
              {post.data.image && (
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-48 object-cover"
                />
              )}
              <div class="p-6 md:p-7 flex flex-col gap-3 flex-grow">
                <div class="flex items-center gap-4">
                  <time class="text-sm text-text-light" datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-GB', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                </div>
                <h2 class="h-card text-text">
                  <a href={`/blog/${post.slug}`} class="hover:text-primary transition-colors">
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-[15px] leading-relaxed text-text-light line-clamp-3">
                  {post.data.description}
                </p>

                {post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <span class="pill pill-primary">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                <a
                  href={`/blog/${post.slug}`}
                  class="link-arrow mt-auto pt-1"
                >
                  Read More<span class="sr-only">: {post.data.title}</span>
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="lede">No blog posts yet. Check back soon!</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
