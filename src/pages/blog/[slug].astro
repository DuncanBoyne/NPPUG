---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const allSpeakers = await getCollection('speakers');
const author = allSpeakers.find(s => s.slug === post.data.author);

const formattedDate = post.data.date.toLocaleDateString('en-GB', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <!-- Header -->
    <header class="page-hero">
      <div class="wrap">
        <div class="max-w-3xl flex flex-col gap-5">
          <span class="kicker">Blog</span>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="pill pill-primary">
                  {tag}
                </span>
              ))}
            </div>
          )}
          <h1 class="h-display text-text">{post.data.title}</h1>
          <p class="lede">{post.data.description}</p>

          <div class="flex items-center gap-4 pt-2">
            {author ? (
              <a href={`/speakers/${author.slug}`} class="flex items-center gap-3 group">
                {author.data.image ? (
                  <img
                    src={author.data.image}
                    alt={author.data.name}
                    class="w-12 h-12 rounded-full object-cover shrink-0"
                  />
                ) : (
                  <div class="w-12 h-12 rounded-full bg-primary-tint text-primary-deep flex items-center justify-center font-display font-bold shrink-0">
                    {author.data.name.split(' ').map(n => n[0]).join('')}
                  </div>
                )}
                <div class="flex flex-col gap-0.5">
                  <div class="font-semibold text-text group-hover:text-primary transition-colors">{author.data.name}</div>
                  <time class="text-sm text-text-light">{formattedDate}</time>
                </div>
              </a>
            ) : (
              <div class="flex flex-col gap-0.5">
                <div class="font-semibold text-text">{post.data.author}</div>
                <time class="text-sm text-text-light">{formattedDate}</time>
              </div>
            )}
          </div>
        </div>
      </div>
    </header>

    <!-- Content -->
    <div class="wrap py-12 md:py-16">
      <div class="max-w-3xl">
        <div class="prose prose-lg max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- Back Link -->
  <div class="wrap pb-12 md:pb-16">
    <a href="/blog" class="link-arrow">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M11 6l-6 6 6 6" />
      </svg>
      Back to Blog
    </a>
  </div>
</BaseLayout>
