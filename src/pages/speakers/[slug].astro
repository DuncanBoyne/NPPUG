---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const speakers = await getCollection('speakers');
  return speakers.map((speaker) => ({
    params: { slug: speaker.slug },
    props: { speaker },
  }));
}

const { speaker } = Astro.props;
const { Content } = await speaker.render();

// Get events this speaker has participated in
const allEvents = await getCollection('events');
const speakerEvents = allEvents.filter(event =>
  event.data.speakers.includes(speaker.slug)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const initials = speaker.data.name.split(' ').map(n => n[0]).join('').toUpperCase();

const socialClass = 'w-11 h-11 rounded-full border border-border-strong bg-surface flex items-center justify-center text-text-light hover:text-primary hover:border-primary transition-colors';
---

<BaseLayout title={speaker.data.name} description={speaker.data.bio}>
  <section class="page-hero">
    <div class="wrap">
      <div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-10">
        <!-- Avatar -->
        {speaker.data.image ? (
          <img src={speaker.data.image} alt={speaker.data.name} class="w-32 h-32 md:w-40 md:h-40 rounded-full object-cover border-4 border-surface shrink-0" />
        ) : (
          <div class="w-32 h-32 md:w-40 md:h-40 rounded-full bg-primary-tint text-primary-deep flex items-center justify-center font-display font-bold text-4xl md:text-5xl border-4 border-surface shrink-0" aria-hidden="true">
            {initials}
          </div>
        )}

        <div class="flex flex-col gap-3">
          {speaker.data.isOrganizer && (
            <span class="pill pill-primary w-fit">Organiser</span>
          )}
          <h1 class="h-display text-text">{speaker.data.name}</h1>
          <p class="text-lg md:text-xl font-semibold text-primary">{speaker.data.title}</p>
          {speaker.data.company && (
            <p class="text-text-light">{speaker.data.company}</p>
          )}

          <!-- Social links -->
          <div class="flex gap-2.5 pt-2">
            {speaker.data.linkedin && (
              <a href={speaker.data.linkedin} target="_blank" rel="noopener noreferrer" class={socialClass} aria-label={`${speaker.data.name}'s LinkedIn (opens in new tab)`}>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9.5h4V21H3zM9.5 9.5H13.3v1.6h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.2c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4z" />
                </svg>
              </a>
            )}
            {speaker.data.twitter && (
              <a href={speaker.data.twitter} target="_blank" rel="noopener noreferrer" class={socialClass} aria-label={`${speaker.data.name}'s Twitter/X (opens in new tab)`}>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              </a>
            )}
            {speaker.data.github && (
              <a href={speaker.data.github} target="_blank" rel="noopener noreferrer" class={socialClass} aria-label={`${speaker.data.name}'s GitHub (opens in new tab)`}>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
              </a>
            )}
            {speaker.data.website && (
              <a href={speaker.data.website} target="_blank" rel="noopener noreferrer" class={socialClass} aria-label={`${speaker.data.name}'s website (opens in new tab)`}>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.75 5.7 3.75 9s-1.25 6.3-3.75 9c-2.5-2.7-3.75-5.7-3.75-9S9.5 5.7 12 3z" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap py-12 md:py-16">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Main content -->
      <div class="lg:col-span-8 flex flex-col gap-6">
        <h2 class="h-card text-[26px] text-text">About</h2>
        <div class="prose prose-lg max-w-none">
          <Content />
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 flex flex-col gap-5">
        {speaker.data.presentations.length > 0 && (
          <div class="card p-6 flex flex-col gap-4">
            <h3 class="text-[13px] font-bold tracking-[0.1em] uppercase text-text-light">Presentations</h3>
            <ul class="flex flex-col gap-1">
              {speaker.data.presentations.map((presentation) => (
                <li>
                  <a href={presentation.url} target="_blank" rel="noopener noreferrer" class="flex items-start gap-3 -mx-2 p-2 rounded-xl hover:bg-surface-muted transition-colors">
                    <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14" />
                    </svg>
                    <div class="flex flex-col gap-0.5">
                      <span class="font-semibold text-text">{presentation.title}<span class="sr-only"> (opens in new tab)</span></span>
                      {presentation.event && (
                        <span class="text-sm text-text-light">{presentation.event}</span>
                      )}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {speakerEvents.length > 0 && (
          <div class="card p-6 flex flex-col gap-4">
            <h3 class="text-[13px] font-bold tracking-[0.1em] uppercase text-text-light">Events</h3>
            <ul class="flex flex-col gap-1">
              {speakerEvents.map((event) => (
                <li>
                  <a href={`/events/${event.slug}`} class="flex flex-col gap-1 -mx-2 p-2 rounded-xl hover:bg-surface-muted transition-colors">
                    <span class="font-semibold text-text">{event.data.title}</span>
                    <span class="text-sm text-text-light">
                      {event.data.date.toLocaleDateString('en-GB', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </span>
                    {event.data.isPast && (
                      <span class="pill w-fit">Past</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>

  <!-- Back link -->
  <div class="wrap pb-12">
    <a href="/speakers" class="link-arrow">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M11 18l-6-6 6-6" /></svg>
      Back to all speakers
    </a>
  </div>
</BaseLayout>
