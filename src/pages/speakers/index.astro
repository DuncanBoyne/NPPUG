---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SpeakerCard from '../../components/SpeakerCard.astro';
import { getCollection } from 'astro:content';

const allSpeakers = await getCollection('speakers');
const speakers = allSpeakers.filter(s => !s.data.isOrganizer);
---

<BaseLayout title="Speakers" description="Meet the speakers who present at Norfolk Power Platform User Group events.">
  <Hero
    kicker="Speakers"
    title="Our Speakers"
    subtitle="Meet the talented individuals who share their knowledge at our events."
  />

  <!-- Speakers -->
  {speakers.length > 0 ? (
    <section class="section" aria-label="Speaker profiles">
      <div class="wrap">
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {speakers.map((speaker) => (
            <SpeakerCard
              name={speaker.data.name}
              title={speaker.data.title}
              company={speaker.data.company}
              bio={speaker.data.bio}
              slug={speaker.slug}
              image={speaker.data.image}
              linkedin={speaker.data.linkedin}
              twitter={speaker.data.twitter}
            />
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="wrap">
        <div class="card p-8 md:p-10 text-center">
          <p class="text-lg text-text-light">Speaker profiles coming soon! Check back after our upcoming events.</p>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="section section-dark" aria-labelledby="become-speaker-heading">
    <div class="wrap flex flex-col items-center text-center gap-5">
      <span class="kicker kicker-on-dark">Get involved</span>
      <h2 id="become-speaker-heading" class="h-section text-white max-w-2xl">Become a Speaker</h2>
      <p class="lede text-text-on-dark max-w-2xl">
        We welcome speakers of all experience levels. Whether it's your first time presenting or you're a seasoned pro, we'd love to hear from you.
      </p>
      <div class="pt-2">
        <a href="/contact" class="btn btn-primary btn-lg">
          Submit a Talk Proposal
          <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
